# Copy this file to the repository root as .project-memory.env.ps1, fill in
# the values, and dot-source it before starting Claude Code or Codex CLI.
# The destination filename is ignored by Git. Never commit the API key.

$env:OBSIDIAN_API_KEY = "PASTE_THE_LOCAL_REST_API_KEY_HERE"
$env:MCP_PROJECT_MEMORY_REPO = "C:\ABSOLUTE\PATH\TO\mcp-project-memory"
