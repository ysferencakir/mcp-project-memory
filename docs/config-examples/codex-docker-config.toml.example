# Build the image as mcp-project-memory:local before using this configuration.
# This example targets Docker Desktop on Windows/macOS. On Linux Docker Engine,
# replace host.docker.internal with 127.0.0.1 and add --network host.
# OBSIDIAN_API_KEY and PROJECT_MEMORY_ROOT are inherited by `docker run`.
# Set both before starting Codex; do not put the API key in this file.

[mcp_servers.project_memory]
command = "docker"
args = [
  "run",
  "--rm",
  "-i",
  "-e",
  "OBSIDIAN_API_KEY",
  "-e",
  "OBSIDIAN_HOST=host.docker.internal",
  "-e",
  "OBSIDIAN_PORT=27124",
  "-e",
  "OBSIDIAN_PROTOCOL=https",
  "-e",
  "PROJECT_MEMORY_ROOT",
  "mcp-project-memory:local",
]
env_vars = ["OBSIDIAN_API_KEY", "PROJECT_MEMORY_ROOT"]
startup_timeout_sec = 30
tool_timeout_sec = 60
enabled = true
required = true
